---
import Layout from '../layouts/Layout.astro';
---

<script>
	import { createClient } from "@supabase/supabase-js";

	const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
	const supabasePubKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

	const supabase = createClient(supabaseUrl, supabasePubKey);

	const {data, error} = await supabase.storage.from("dumps").list("", {
		limit: 1000,
		sortBy: { column: "name", order: "desc" },
	});

	if (error) {
		console.error("Error fetching dump list:", error);
		const statusEl = document.querySelector("[data-status]");
		if (statusEl) {
			statusEl.textContent = "Error loading dump list.";
		}
	} else {
		const dumpListEl = document.querySelector("[data-dump-list]");
		if (dumpListEl) {
			data.filter(file => !file.name.startsWith(".")).forEach((file) => {
				const listItem = document.createElement("li");
				const link = document.createElement("a");

				const {data: url_data} = supabase.storage.from("dumps").getPublicUrl(file.name);

				link.href = url_data.publicUrl;
				link.textContent = file.name;
				listItem.appendChild(link);
				dumpListEl.appendChild(listItem);
			});
			const statusEl = document.querySelector("[data-status]");
			if (statusEl) {
				statusEl.remove();
			}
		}
	}
</script>

<Layout
	title="RealGolf.Games Database"
	description="Monthly GGN dumps of all public RealGolf.Games games."
>
	<header class="hero">
		<div class="brand">
			<img class="brand__logo" src="/logo.png" alt="RealGolf.Games logo" width="52" height="52" />
			<div>
				<p class="eyebrow">database.realgolf.games</p>
				<h1>RealGolf.Games Database</h1>
			</div>
		</div>
		<p class="lead">
			This database publishes monthly GGN dumps of all public games played on
			<a href="https://realgolf.games">RealGolf.Games</a>.
		</p>
	</header>

	<section class="panel">
		<p>
			Each monthly file contains only the games created during that specific month.
			Dumps are <strong>not cumulative</strong> — to build a full dataset, download every file listed below.
		</p>
		<p>
			Data provided by <a href="https://realgolf.games">RealGolf.Games</a>, licensed under
			<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
		</p>
		<ul class="link-list">
			<li><a href="https://github.com/swingalytica/ggn">GGN Specification</a></li>
			<li><a href="https://npmjs.com/package/swingalytica">Official parser</a></li>
		</ul>
	</section>

	<section class="panel">
		<div class="section-heading flex-col">
			<h2>Monthly dumps</h2>
			<p class="status" data-status>Loading dump list…</p>
		</div>
		<noscript>
			<p class="status">Enable JavaScript to fetch the current dump list from Supabase Storage.</p>
		</noscript>
		<ul class="dump-list" data-dump-list></ul>
	</section>

	<footer class="footer">
		Data by RealGolf.Games UG (haftungsbeschränkt) · CC BY 4.0 · Format: GGN
	</footer>
</Layout>